# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="TropiCare"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=127.0.0.1
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Sign in with Google. Google Cloud Console > APIs & Services > Credentials >
# Create OAuth client ID, type "Web application". Add the frontend URLs
# (e.g. http://localhost:5173) under Authorized JavaScript origins.
# The client ID is public, but keep each environment's own value out of git.
# Empty = the Google button is off (POST /login/google answers 503).
GOOGLE_CLIENT_ID=

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@127.0.0.1:5432/app

# SATUSEHAT (https://satusehat.kemkes.go.id/platform/docs/id/api-code/)
# Sandbox codes work for unverified accounts. Production needs a verified
# fasyankes or partner system. Credentials are secret: never commit real values.
SATUSEHAT_ENV=sandbox
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORG_ID=

# AI scoring (backend/app/triage/ai). Used when TRIAGE_SCORING_ENGINE=ai.
# The key comes from Google AI Studio. Secret: never commit a real value.
TRIAGE_SCORING_ENGINE=rules
TRIAGE_AI_PROVIDER=gemini
TRIAGE_AI_MODEL=gemini-3.5-flash-lite
# Tried once when MODEL is busy (503) or out of quota (429), e.g. MODEL=gemini-3.6-flash
# with FALLBACK_MODEL=gemini-3.5-flash-lite. Empty = no second model.
TRIAGE_AI_FALLBACK_MODEL=
TRIAGE_AI_API_KEY=
# Flows scored by the model (others always use rules).
TRIAGE_AI_FLOWS=infection,chronic
# single = 1 request per patient; per_candidate = about 3 to 6.
TRIAGE_AI_MODE=single
# Copy the limits AI Studio shows for your project (per server process).
TRIAGE_AI_RPM_LIMIT=10
TRIAGE_AI_RPD_LIMIT=0
# OpenRouter (free Gemma 4) instead of Gemini: replace the block above with
#   TRIAGE_AI_PROVIDER=openai_compat
#   TRIAGE_AI_BASE_URL=https://openrouter.ai/api/v1
#   TRIAGE_AI_MODEL=google/gemma-4-26b-a4b-it:free
#   TRIAGE_AI_API_KEY=<OpenRouter key, sk-or-...>
#   TRIAGE_AI_SCHEMA_IN_PROMPT=true   # free endpoint does not enforce the JSON schema
#   TRIAGE_AI_RPM_LIMIT=20
#   TRIAGE_AI_RPD_LIMIT=50            # 1000 once the account has bought >= 10 credits
#   TRIAGE_AI_CALL_TIMEOUT_S=30
#   TRIAGE_AI_DEADLINE_S=40
# Optional paid fallback through OpenRouter's `models` list (needs credits):
#   TRIAGE_AI_FALLBACK_MODEL=google/gemma-4-26b-a4b-it
# Empty = JSON lines to the app log (stdout). Or a file, e.g. ../logs/ai_calls.jsonl
TRIAGE_AI_LOG_PATH=
