# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="TropiCare"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=127.0.0.1
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@127.0.0.1:5432/app

# SATUSEHAT (https://satusehat.kemkes.go.id/platform/docs/id/api-code/)
# Sandbox codes work for unverified accounts. Production needs a verified
# fasyankes or partner system. Credentials are secret: never commit real values.
SATUSEHAT_ENV=sandbox
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORG_ID=

# AI scoring (backend/app/triage/ai). Used when TRIAGE_SCORING_ENGINE=ai.
# The key comes from Google AI Studio. Secret: never commit a real value.
TRIAGE_SCORING_ENGINE=rules
TRIAGE_AI_PROVIDER=gemini
TRIAGE_AI_MODEL=gemini-3.6-flash
TRIAGE_AI_API_KEY=
# single = 1 request per patient; per_candidate = about 3 to 6.
TRIAGE_AI_MODE=single
# Copy the limits AI Studio shows for your project (per server process).
TRIAGE_AI_RPM_LIMIT=10
TRIAGE_AI_RPD_LIMIT=0
# Empty = JSON lines to the app log (stdout). Or a file, e.g. ../logs/ai_calls.jsonl
TRIAGE_AI_LOG_PATH=
