VITE_API_URL=http://localhost:8000
MAILPIT_HOST=http://localhost:8025
# "true" = rank nearest facilities on the server (coordinates leave the device,
# for cross-province accuracy). Leave empty to rank in the browser and keep
# coordinates on the device. See docs/SATUSEHAT.md §3.
VITE_FACILITIES_SERVER_NEAREST=
# OAuth Client ID (Web) from Google Cloud Console for "Masuk dengan Google".
# Same value as the backend's GOOGLE_CLIENT_ID. Empty = the Google button is hidden.
VITE_GOOGLE_CLIENT_ID=
